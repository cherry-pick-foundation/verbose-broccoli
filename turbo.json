{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "globalDependencies": [
    ".venv/lib/**",
    "tools/ruff/.venv/lib/**",
    "tools/shellcheck/.venv/lib/**",
    "tools/check-jsonschema/.venv/lib/**",
    "!**/__pycache__/**",
    "!**/*.pth",
    "!**/*.dist-info/direct_url.json",
    "!**/*.dist-info/RECORD",
    "!**/*.dist-info/uv_cache.json"
  ],
  "globalEnv": [
    "VERBOSE_BROCCOLI_TOOLCHAIN",
    "UV_*",
    "MISE_*",
    "CI",
    "VERBOSE_BROCCOLI_CONFIG"
  ],
  "globalPassThroughEnv": [
    "HOME",
    "PATH",
    "XDG_*",
    "RUSTUP_HOME",
    "CARGO_HOME",
    "PYTHONDONTWRITEBYTECODE",
    "TMPDIR"
  ],
  "futureFlags": {
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "//#doctor": {
      "description": "Run mise's project checks; uncached because it checks the installed tools and environments",
      "cache": false
    },
    "//#format:check": {},
    "//#lint": {},
    "//#lint:shell": {},
    "//#lint:names": {
      "description": "Check file and folder names with ls-lint; uncached because Turborepo does not hash empty folders",
      "cache": false
    },
    "//#typecheck": {},
    "//#plugins:validate": {},
    "//#test:plugins-validate": {},
    "//#clean-code": {},
    "//#clean-architecture": {},
    "//#python:imports": {},
    "//#doc-regions:check": {
      "description": "Check mechanical regions and local links in the target documents, offline and without writing"
    },
    "//#backfire:regions:check": {
      "description": "Check that backfire's generated region list matches the vendored legal-district codes, offline and without writing"
    },
    "//#test:backfire-regions": {},
    "//#test:ruff": {},
    "//#test:gts": {},
    "//#test:git-flow": {},
    "//#test:constitution-bump": {
      "description": "Test the constitution version bump; uncached because it runs mise exec, whose version and global config are not hashed",
      "cache": false
    },
    "//#test:worktree-branch": {},
    "//#test:lint-names": {
      "description": "Test the name check; uncached because it finds ls-lint through mise, whose version and global config are not hashed",
      "cache": false
    },
    "//#test:commit-msg": {},
    "//#test:plugin-skills": {},
    "//#test:clean-code": {},
    "//#test:clean-architecture": {},
    "//#test:workflow": {},
    "//#test:mise-doctor": {
      "description": "Test mise's project checks; uncached because it runs mise, whose version and global config are not hashed",
      "cache": false
    },
    "//#test:cli-contract": {},
    "//#test:session-select": {},
    "backfire#test": {
      "command": [
        "env",
        "PYTHONDONTWRITEBYTECODE=1",
        "uv",
        "--directory",
        "../..",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "--package",
        "backfire",
        "pytest",
        "packages/backfire/tests"
      ]
    },
    "doc-regions#test": {
      "command": [
        "env",
        "PYTHONDONTWRITEBYTECODE=1",
        "uv",
        "--directory",
        "../..",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "--package",
        "doc-regions",
        "pytest",
        "-p",
        "no:cacheprovider",
        "packages/doc-regions/tests",
        "scripts/doc_sources_test.py"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/doc_sources.py",
        "../../scripts/doc_sources_test.py"
      ]
    },
    "jev-ultrafast#test": {
      "command": [
        "env",
        "PYTHONDONTWRITEBYTECODE=1",
        "PYTHONPATH=packages/jev-ultrafast",
        "uv",
        "--directory",
        "../..",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "--package",
        "jev-ultrafast",
        "pytest",
        "-p",
        "no:cacheprovider",
        "packages/jev-ultrafast/tests"
      ]
    },
    "credit-offers#test": {
      "command": [
        "env",
        "PYTHONDONTWRITEBYTECODE=1",
        "uv",
        "--directory",
        "../..",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "--package",
        "credit-offers",
        "pytest",
        "-p",
        "no:cacheprovider",
        "packages/credit-offers/tests"
      ]
    },
    "wiki-consistency#test": {
      "command": [
        "env",
        "PYTHONDONTWRITEBYTECODE=1",
        "uv",
        "--directory",
        "../..",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "--package",
        "wiki-consistency",
        "pytest",
        "packages/wiki-consistency/tests"
      ]
    },
    "//#test:grammatical-competence": {},
    "//#test:wiki-raw-import": {},
    "//#test:turbo-cache": {},
    "verbose-broccoli-python#test": {
      "command": ["true"],
      "dependsOn": [
        "//#test:constitution-bump",
        "//#test:ruff",
        "//#test:gts",
        "//#test:git-flow",
        "//#test:worktree-branch",
        "//#test:backfire-regions",
        "//#test:lint-names",
        "//#test:commit-msg",
        "//#test:plugin-skills",
        "//#test:clean-code",
        "//#test:clean-architecture",
        "//#test:workflow",
        "//#test:mise-doctor",
        "//#test:cli-contract",
        "//#test:plugins-validate",
        "backfire#test",
        "doc-regions#test",
        "jev-ultrafast#test",
        "credit-offers#test",
        "wiki-consistency#test",
        "//#test:grammatical-competence",
        "//#test:session-select",
        "//#test:wiki-raw-import",
        "//#test:turbo-cache"
      ],
      "cache": false
    },
    "//#doc-regions:update": {
      "description": "Regenerate stale mechanical regions in the target documents",
      "cache": false
    },
    "//#doc-regions:prepare": {
      "description": "Print backfire requests for the agent regions before a develop merge review (pass --base and --max-evidence-chars)",
      "cache": false
    },
    "//#doc-regions:audit": {
      "description": "Run MemoryLint's read-only audit on AGENTS.md and the constitution",
      "cache": false
    },
    "verbose-broccoli-python#check": {
      "command": ["true"],
      "dependsOn": [
        "//#doctor",
        "//#format:check",
        "//#lint",
        "//#lint:shell",
        "//#lint:names",
        "//#typecheck",
        "//#plugins:validate",
        "//#clean-code",
        "//#clean-architecture",
        "//#python:imports",
        "verbose-broccoli-python#test",
        "//#doc-regions:check",
        "//#backfire:regions:check"
      ],
      "cache": false
    },
    "backfire#check": {"command": ["true"], "cache": false},
    "doc-regions#check": {"command": ["true"], "cache": false},
    "wiki-consistency#check": {"command": ["true"], "cache": false}
  }
}
