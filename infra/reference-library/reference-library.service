[Unit]
Description=Reference library: forward to the local API, idle for 10 minutes then stop
BindsTo=reference-library-app.service
Requires=reference-library-gateway.service
After=reference-library-app.service reference-library-gateway.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=10min 127.0.0.1:23191
