#!/bin/sh
unset CONSTITUTION_VERSION_COMMIT

# Git does not tell a commit-msg hook about --amend, so read the arguments of
# the git process that runs this hook, split on NUL bytes, and match --amend and
# the abbreviations git accepts for it as whole arguments.
if [ -r "/proc/${PPID}/cmdline" ]; then
  amend=$(od -An -v -tu1 "/proc/${PPID}/cmdline" 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == 0) {if (arg ~ /^--am(end|e|en)?$/) amend = 1; else if (arg ~ /^--no-am(end|e|en)?$/) amend = 0; arg = ""} else arg = arg sprintf("%c", $i)} END {print amend + 0}')
else
  amend=0
fi
if [ "${amend}" = 1 ]; then export CONSTITUTION_VERSION_AMEND=1; else unset CONSTITUTION_VERSION_AMEND; fi

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'Commit refused: Node.js 24.12.0 or later was not found.' >&2
  exit 1
fi

export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=SecurityWarning"
exec npm run --silent commitlint -- --edit "$1"
