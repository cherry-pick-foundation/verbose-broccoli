#!/bin/sh
set -eu

if [ -z "${EXIT_CODE:-}" ]; then
  printf '%s\n' 'Post-merge cleanup: git-flow did not report the finish result; inspect the finish manually and preserve the source branch and worktree.'
  exit 0
fi
[ "${EXIT_CODE}" = 0 ] || exit 0

branch=${BRANCH:-${3-}}
if [ -z "${branch}" ]; then
  printf '%s\n' 'Post-merge cleanup: git-flow did not provide the source branch; inspect the finish manually and preserve the source branch and worktree.'
  exit 0
fi

if ! tip=$(git rev-parse --verify --quiet "refs/heads/${branch}^{commit}"); then
  printf 'Post-merge cleanup: cannot resolve the retained tip of %s; do not remove its worktree until inspected.\n' "${branch}"
  exit 0
fi

base_branch=${BASE_BRANCH:-}
base_tip=
base_merged=false
if [ -n "${base_branch}" ]; then
  if base_tip=$(git rev-parse --verify --quiet "refs/heads/${base_branch}^{commit}"); then
    if git merge-base --is-ancestor "${tip}" "${base_tip}"; then
      base_merged=true
    fi
  fi
fi

worktree=$(git worktree list --porcelain | awk -v branch="refs/heads/${branch}" '
  /^worktree / {path = substr($0, 10)}
  $1 == "branch" && $2 == branch {print path; exit}
')
removal_selector=
printf '\nPost-merge cleanup for %s\n' "${branch}"
printf 'Source branch tip: %s\n' "${tip}"
if [ -z "${worktree}" ]; then
  printf '%s\n' 'Source worktree: not found; inspect Orca and Git worktree state before cleanup.'
else
  quoted_worktree=$(git rev-parse --sq-quote "${worktree}")
  printf 'Source worktree: %s\n' "${quoted_worktree# }"
  if [ ! -d "${worktree}" ]; then
    printf '%s\n' 'The source directory is missing; inspect it before removing any worktree metadata.'
  elif [ ! -e "${worktree}/.git" ]; then
    printf '%s\n' 'The source worktree metadata is missing; inspect and preserve it.'
  elif ! status=$(git -C "${worktree}" status --porcelain --untracked-files=all --ignored=matching); then
    printf '%s\n' 'The source worktree status could not be checked; do not remove it.'
  elif [ -n "${status}" ]; then
    printf '%s\n' 'The source worktree is dirty; preserve it and inspect its changes.'
  elif [ "${base_merged}" != true ]; then
    if [ -z "${base_branch}" ] || [ -z "${base_tip}" ]; then
      printf '%s\n' 'The target base branch is missing or unresolved; preserve the source branch and inspect it.'
    else
      printf 'The source tip is not merged into %s; preserve the source branch and inspect it.\n' "${base_branch}"
    fi
  else
    printf '%s\n' 'The source worktree is clean.'
    removal_selector=$(git rev-parse --sq-quote "path:${worktree}")
  fi
fi
cat <<'EOF'
Before removal, record the source tip above. In Orca, settle workers first and
close only idle feature sessions and terminals. Preserve active or unsettled
workers, unrelated tabs, dirty or unmerged worktrees, and source evidence. Use
Orca to remove only the completed clean source worktree.
EOF
restore_branch=$(git rev-parse --sq-quote "${branch}")
restore_tip=$(git rev-parse --sq-quote "${tip}")
printf 'If Orca deleted the source branch, recreate it at the recorded tip with: git branch %s %s\n' \
  "${restore_branch# }" "${restore_tip# }"
if [ -n "${removal_selector}" ]; then
  printf 'Orca removal command: orca-ide worktree rm --worktree %s\n' \
    "${removal_selector# }"
fi
