{
  "env": {
    "SPECKIT_PYTHON": "tools/spec-kit/.venv/bin/python"
  },
  "permissions": {
    "deny": [
      "mcp__plugin_work_reference-library__zotero_delete_items",
      "mcp__plugin_work_reference-library__zotero_delete_collection",
      "mcp__plugin_work_reference-library__zotero_empty_trash",
      "mcp__reference-library__zotero_delete_items",
      "mcp__reference-library__zotero_delete_collection",
      "mcp__reference-library__zotero_empty_trash"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-child-process \"$(git rev-parse --show-toplevel)/scripts/coordinator-context.ts\" claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
