{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "jev-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "${PLUGIN_ROOT}/../../packages/education-privacy-gate",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "jev-mcp"
      ]
    },
    "reference-library": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/node_modules/zotero-native-mcp/build/index.js"],
      "env": {
        "ZOTERO_LOCAL_BASE_URL": "http://127.0.0.1:23190",
        "ZOTERO_LOCAL_APP_NAME": "Agent reference library"
      }
    }
  }
}
