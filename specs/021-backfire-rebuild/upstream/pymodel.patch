+async def test_large_arguments_and_results_use_worker_threads(monkeypatch: pytest.MonkeyPatch) -> None:
+    loop_thread = get_ident()
+    parse_threads: list[int] = []
+    serialize_threads: list[int] = []
+    payload = "x" * (10 * 1024 * 1024)
+
+    async def handler(parsed: dict[str, Any], _runtime: Runtime) -> ToolResult:
+        return ToolResult({"note": parsed["note"]})
+
+    toolset = _toolset(handler)
+    parse_arguments = ArgumentParser.__call__
+
+    def parse(parser: ArgumentParser, arguments: Mapping[str, object] | None) -> dict[str, object]:
+        parse_threads.append(get_ident())
+        return parse_arguments(parser, arguments)
+
+    stringify = toolset_module.stringify
+
+    def serialize(value: object) -> str:
+        serialize_threads.append(get_ident())
+        return stringify(value)
+
+    monkeypatch.setattr(ArgumentParser, "__call__", parse)
+    monkeypatch.setattr(toolset_module, "stringify", serialize)
+    try:
+        result = await toolset.call("boom", {"note": payload})
+    finally:
+        await toolset.aclose()
+
+    text = _text(result)
+    assert not result.is_error
+    assert text.startswith('{\n  "note": "') and text.endswith('"\n}')
+    assert parse_threads and all(thread != loop_thread for thread in parse_threads)
+    assert serialize_threads and all(thread != loop_thread for thread in serialize_threads)
+
