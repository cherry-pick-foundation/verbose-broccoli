{
  "name": "verbose-broccoli",
  "private": true,
  "packageManager": "npm@12.1.0",
  "workspaces": [
    "tools/none"
  ],
  "scripts": {
    "doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=package.json --allow-fs-read=package-lock.json --allow-fs-read=pyproject.toml --allow-fs-read=uv.lock --allow-fs-read=packages --allow-fs-read=node_modules --allow-fs-read=scripts --allow-fs-read=plugins --allow-fs-read=/usr/local/bin/quarto --allow-fs-read=/opt/quarto/bin/quarto --allow-fs-read=\"$(realpath \"$(command -v deno)\")\" --allow-fs-read=\"$(dirname \"$(dirname \"$(dirname \"$(node -p process.execPath)\")\")\")\" --allow-child-process --import ./scripts/deno_shim.ts scripts/doctor.ts",
    "test:plugin-skills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/plugin_skills_test.ts",
    "test:doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/doctor_test.ts",
    "test:git-flow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/git_flow_test.ts",
    "test:worktree-branch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=/tmp --allow-child-process --import ./scripts/deno_shim.ts --test scripts/worktree_branch_test.ts",
    "commitlint": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import=./scripts/deno_shim.ts --permission --allow-fs-read=* --allow-child-process' commitlint --config scripts/commitlint.config.mjs",
    "test:commit-msg": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/commit_msg_test.ts",
    "workflow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts scripts/workflow.ts",
    "verify": "npm run workflow -- --verify",
    "test:cli-contract": "NODE_OPTIONS=--disable-warning=SecurityWarning node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/cli_contract_test.ts",
    "test:workflow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/workflow_test.ts scripts/workflow_plan_test.ts scripts/workflow_verify_test.ts scripts/workflow_graph_test.ts scripts/workflow_skills_test.ts",
    "lint": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-child-process' biome lint --error-on-warnings .",
    "lint:shell": "git ls-files -z --cached --others --exclude-standard -- '*.sh' scripts/git-hooks scripts/git-flow-hooks ':(exclude).specify/**' | xargs -0 uv run --project tools/shellcheck --frozen --offline --no-sync shellcheck",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "plugins:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=node_modules --allow-fs-read=scripts --allow-fs-read=plugins --import ./scripts/deno_shim.ts scripts/validate_plugins.ts",
    "clean-architecture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --import ./scripts/deno_shim.ts scripts/clean_architecture.ts",
    "clean-code": "deno run --quiet --config plugins/code/skills/clean-code/deno.json --frozen --cached-only --no-prompt --allow-read --allow-env plugins/code/skills/clean-code/scripts/clean_code.ts",
    "clean-code:scope": "npm run clean-code -- --scope",
    "test:clean-code": "deno test --config plugins/code/skills/clean-code/deno.json --frozen --cached-only --no-prompt --allow-read --allow-write --allow-env plugins/code/skills/clean-code/scripts/clean_code_test.ts",
    "backfire:build": "uv run --project packages/backfire --frozen --offline --no-sync python -m backfire_tools.build",
    "backfire:install": "uv sync --project packages/backfire --frozen --extra education",
    "backfire:ready": "uv run --project packages/backfire --frozen --offline --no-sync backfire ready",
    "backfire:eval": "uv run --project packages/backfire --frozen --offline --no-sync python -m backfire_tools.acceptance.evaluate",
    "test:backfire": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen --offline --no-sync --package backfire pytest packages/backfire/tests -m 'not slow'",
    "test:backfire-slow": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen --offline --no-sync --package backfire pytest packages/backfire/tests -m slow",
    "doc-regions:check": "PYTHONDONTWRITEBYTECODE=1 uv run --project packages/doc-regions --frozen --offline --no-sync doc-regions check scripts/doc_regions.toml",
    "doc-regions:update": "PYTHONDONTWRITEBYTECODE=1 uv run --project packages/doc-regions --frozen --offline --no-sync doc-regions update scripts/doc_regions.toml",
    "doc-regions:prepare": "PYTHONDONTWRITEBYTECODE=1 uv run --project packages/doc-regions --frozen --offline --no-sync doc-regions prepare scripts/doc_regions.toml",
    "doc-regions:audit": "PYTHONDONTWRITEBYTECODE=1 uv run --project packages/doc-regions --frozen --offline --no-sync doc-regions audit scripts/doc_regions.toml",
    "wiki-consistency:install": "uv sync --locked --project packages/wiki-consistency && npm ci --ignore-scripts --no-audit --no-fund --prefix packages/wiki-consistency",
    "test:wiki-consistency": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen --offline --no-sync --package wiki-consistency pytest packages/wiki-consistency/tests",
    "test:doc-regions": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen --offline --no-sync --package doc-regions pytest -p no:cacheprovider packages/doc-regions/tests scripts/doc_sources_test.py",
    "check": "turbo run check",
    "lint:fix": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-child-process' biome lint --write --error-on-warnings .",
    "format": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-child-process' biome format --write . && NODE_OPTIONS='--permission --allow-fs-read=*' prettier --write --single-quote .github/ orca.yaml",
    "format:check": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-child-process' biome format . && NODE_OPTIONS='--permission --allow-fs-read=*' prettier --check --single-quote .github/ orca.yaml",
    "test:clean-architecture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/clean_architecture_test.ts",
    "test": "turbo run test",
    "docs:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=node_modules --allow-fs-read=\"$(realpath node_modules)\" --allow-fs-read=scripts --allow-fs-read=plugins --allow-fs-read=docs --allow-fs-read=package.json --allow-fs-read=package-lock.json --allow-fs-read=deno.json --allow-fs-read=turbo.json --allow-fs-read=tsconfig.json --allow-fs-read=biome.json --allow-fs-write=docs --allow-child-process --allow-fs-read=\"$(realpath \"$(command -v deno)\")\" --allow-fs-read=$HOME/.deno/bin/deno --import ./scripts/deno_shim.ts scripts/docs.ts generate",
    "docs:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=node_modules --allow-fs-read=\"$(realpath node_modules)\" --allow-fs-read=scripts --allow-fs-read=plugins --allow-fs-read=docs --allow-fs-read=package.json --allow-fs-read=package-lock.json --allow-fs-read=deno.json --allow-fs-read=turbo.json --allow-fs-read=tsconfig.json --allow-fs-read=biome.json --allow-child-process --allow-fs-read=\"$(realpath \"$(command -v deno)\")\" --allow-fs-read=$HOME/.deno/bin/deno --import ./scripts/deno_shim.ts scripts/docs.ts check",
    "test:docs": "NODE_OPTIONS=--disable-warning=SecurityWarning node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/docs_test.ts",
    "test:wiki-raw-import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --import ./scripts/deno_shim.ts --test scripts/wiki_raw_import_test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cliffy/command": "npm:@jsr/cliffy__command@1.2.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@deno/shim-deno": "0.19.2",
    "@eemeli/yaml": "npm:@jsr/eemeli__yaml@2.9.1",
    "@mdx-js/mdx": "3.1.1",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@std/fs": "npm:@jsr/std__fs@1.0.24",
    "@std/path": "npm:@jsr/std__path@1.1.6",
    "@std/testing": "npm:@jsr/std__testing@1.0.20",
    "@types/node": "22.20.2",
    "@zod/zod": "npm:zod@4.6.2",
    "ajv": "8.20.0",
    "canonicalize": "5.0.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "dependency-cruiser": "18.2.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.9.9",
    "proper-lockfile": "4.1.2",
    "remark-gfm": "4.0.1",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0"
  }
}
