.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

node_modules/

# Local Python and Rust build output
__pycache__/
*.pyc

# Operating-system metadata
.DS_Store

# Rebuildable Wiki output and private local execution evidence
/generated/
/.local/

# Local copies of operator configuration; tracked examples contain no secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
/infra/*.env
/authorization.json
