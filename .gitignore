# Deno
# https://deno.com/

# Cache directory (when using project-local DENO_DIR)
# https://docs.deno.com/runtime/fundamentals/setup/#deno_dir
.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

node_modules/
.venv/
packages/backfire/src/*.egg-info/

# Local Python and Rust build output
__pycache__/
*.pyc
/tools/spec-kit/.venv/

# Operating-system metadata
.DS_Store

# Rebuildable Wiki output and private local execution evidence
/generated/
/.local/

# Per-worktree pointer to the current Spec Kit plan, written by the
# agent-context extension
/.claude/rules/current-plan.md

# Local copies of operator configuration; tracked examples contain no secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
/infra/*.env
/authorization.json
