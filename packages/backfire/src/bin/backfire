#!/bin/sh
set -eu

fail() {
  printf 'backfire: %s\n' "$*" >&2
  exit 1
}

[ "$#" -eq 1 ] || fail "Usage: $0 {install|serve-mcp|ready}"
case "$1" in
  install|serve-mcp|ready) command_name=$1 ;;
  *) fail "Usage: $0 {install|serve-mcp|ready}" ;;
esac

PATH=${PATH:-/usr/local/bin:/usr/bin:/bin}
export PATH
script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P) || fail "Cannot locate this component."
component_root=$(CDPATH= cd -P "$script_dir/../.." && pwd -P) || fail "Cannot locate this component."

if [ -z "${HOME:-}" ]; then
  HOME=$(getent passwd "$(id -u)" | awk -F: 'NR == 1 { print $6 }') || HOME=
fi
[ -n "$HOME" ] || fail "Cannot resolve HOME from the account database."

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export HOME PATH XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME

find_tool() {
  tool_path=$(command -v "$1" 2>/dev/null || true)
  [ -n "$tool_path" ] || tool_path=$2
  [ -x "$tool_path" ] || return 1
  case "$tool_path" in
    /*) printf '%s\n' "$tool_path" ;;
    *)
      tool_dir=$(CDPATH= cd -P "$(dirname "$tool_path")" && pwd -P) || return 1
      printf '%s/%s\n' "$tool_dir" "$(basename "$tool_path")"
      ;;
  esac
}

DENO=$(find_tool deno "$HOME/.deno/bin/deno") || fail "Deno 2.9.6 is required at ~/.deno/bin/deno or on PATH."
UV=$(find_tool uv "$HOME/.local/bin/uv") || fail "uv is required at ~/.local/bin/uv or on PATH."
PATH="$(dirname "$DENO"):$(dirname "$UV"):$PATH"
export PATH
DENO_VERSION=$("$DENO" --version 2>&1) || fail "Unable to check the Deno version."
case "$DENO_VERSION" in
  "deno 2.9.6"*) ;;
  *) fail "Deno 2.9.6 is required." ;;
esac
"$UV" --version >/dev/null 2>&1 || fail "Unable to run uv."

copy_id=$(printf '%s' "$component_root" | "$DENO" eval --no-config --no-prompt '
const path = await new Response(Deno.stdin.readable).text();
const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(path));
const hex = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
console.log(hex.slice(0, 16));
') || fail "Unable to identify this component copy."

venv_root="$XDG_CACHE_HOME/verbose-broccoli/backfire/venv"
environment="$venv_root/$copy_id"

prune_environments() {
  [ -d "$venv_root" ] || return 0
  for old_environment in "$venv_root"/*; do
    [ -d "$old_environment" ] || continue
    [ -f "$old_environment/component-root" ] || continue
    old_root=
    IFS= read -r old_root < "$old_environment/component-root" || :
    if [ ! -d "$old_root" ]; then
      rm -rf "$old_environment"
    fi
  done
}

require_environment() {
  [ -x "$environment/bin/python" ] && [ -f "$environment/component-root" ] || fail "Backfire environment is missing; run $component_root/src/bin/backfire install."
  recorded_root=
  IFS= read -r recorded_root < "$environment/component-root" || :
  [ "$recorded_root" = "$component_root" ] || fail "Backfire environment is missing; run $component_root/src/bin/backfire install."
  if ! (cd "$component_root" && "$DENO" install --config "$component_root/deno.json" --frozen --cached-only --no-prompt >/dev/null 2>&1); then
    fail "Backfire cached modules are missing; run $component_root/src/bin/backfire install."
  fi
}

run_entry() {
  # exec so that the server itself receives the client's SIGTERM and SIGINT.
  exec "$DENO" run --config "$component_root/deno.json" --frozen --cached-only --no-prompt \
    "--allow-read=$component_root/src,$XDG_STATE_HOME/verbose-broccoli/backfire/records" \
    "--allow-write=$XDG_STATE_HOME/verbose-broccoli/backfire/records" \
    --allow-env=HOME,PATH,XDG_CACHE_HOME,XDG_CONFIG_HOME,XDG_DATA_HOME,XDG_STATE_HOME,BACKFIRE_TEST_PROVIDER_BASE_URL,JEV_PROVIDER,JEV_API_BASE_URL,JEV_API_KEY,JEV_MCP_MODEL,JEV_MCP_REQUEST_TIMEOUT_MS,JEV_MCP_MAX_ATTEMPTS \
    "--allow-run=$environment/bin/python" \
    --allow-net=127.0.0.1 \
    "$component_root/$1"
}

case "$command_name" in
  install)
    prune_environments
    mkdir -p "$venv_root"
    (
      cd "$component_root"
      UV_PROJECT_ENVIRONMENT="$environment" "$UV" sync --frozen
    )
    printf '%s\n' "$component_root" > "$environment/component-root"
    (cd "$component_root" && "$DENO" install --config "$component_root/deno.json" --frozen --no-prompt)
    ;;
  serve-mcp)
    require_environment
    run_entry src/server/main.ts
    ;;
  ready)
    require_environment
    run_entry src/server/ready.ts
    ;;
esac
